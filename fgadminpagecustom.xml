<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_fgadminpagecustom</name>
    <author>Fero</author>
    <authorUrl>https://github.com/FGcodework</authorUrl>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026. GNU GPL v2 or later.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.4.4</version>
    <description>PLG_SYSTEM_FGADMINPAGECUSTOM_XML_DESCRIPTION</description>
    <namespace path="src">FG\Plugin\System\AdminPageCustom</namespace>
    <updateservers>
        <server type="extension" name="System - FG Admin Page Customizer Update Site">https://raw.githubusercontent.com/FGcodework/plg_system_fgadminpagecustom/master/updates.xml</server>
    </updateservers>
    <files>
        <folder plugin="fgadminpagecustom">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_fgadminpagecustom.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_fgadminpagecustom.sys.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgadminpagecustom.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgadminpagecustom.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="support_note"
                    type="note"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_FIELD_SUPPORT_DESC"
                />
            </fieldset>

            <fieldset name="branding" label="PLG_SYSTEM_FGADMINPAGECUSTOM_FIELDSET_BRANDING">
                <field
                    name="brand_color"
                    type="color"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_BRAND_COLOR_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_BRAND_COLOR_DESC"
                />
                <field
                    name="header_color"
                    type="color"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_HEADER_COLOR_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_HEADER_COLOR_DESC"
                />
                <field
                    name="sidebar_follow"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_SIDEBAR_FOLLOW_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_SIDEBAR_FOLLOW_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="sidebar_color"
                    type="color"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_SIDEBAR_COLOR_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_SIDEBAR_COLOR_DESC"
                />
                <field
                    name="page_bg"
                    type="color"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_PAGE_BG_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_PAGE_BG_DESC"
                />
                <field
                    name="logo"
                    type="media"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_DESC"
                />
                <field
                    name="logo_small"
                    type="media"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_SMALL_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_SMALL_DESC"
                />
                <field
                    name="logo_height"
                    type="number"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_HEIGHT_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_LOGO_HEIGHT_DESC"
                    min="16"
                    max="120"
                />
            </fieldset>

            <fieldset name="shape" label="PLG_SYSTEM_FGADMINPAGECUSTOM_FIELDSET_SHAPE">
                <field
                    name="ctrl_radius"
                    type="number"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_CTRL_RADIUS_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_CTRL_RADIUS_DESC"
                    default=""
                    min="0"
                    max="40"
                />
                <field
                    name="card_radius"
                    type="number"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_CARD_RADIUS_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_CARD_RADIUS_DESC"
                    default=""
                    min="0"
                    max="40"
                />
                <field
                    name="btn_shadow"
                    type="list"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_BTN_SHADOW_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_BTN_SHADOW_DESC"
                    default="none"
                >
                    <option value="none">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_STRONG</option>
                </field>
                <field
                    name="card_shadow"
                    type="list"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_CARD_SHADOW_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_CARD_SHADOW_DESC"
                    default="none"
                >
                    <option value="none">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINPAGECUSTOM_SHADOW_STRONG</option>
                </field>
            </fieldset>

            <fieldset name="behavior" label="PLG_SYSTEM_FGADMINPAGECUSTOM_FIELDSET_BEHAVIOR">
                <field
                    name="menu_open_first"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_MENU_OPEN_FIRST_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_MENU_OPEN_FIRST_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset name="importexport" label="PLG_SYSTEM_FGADMINPAGECUSTOM_FIELDSET_IMPORTEXPORT">
                <field
                    name="export_json"
                    type="textarea"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_EXPORT_JSON_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_EXPORT_JSON_DESC"
                    rows="10"
                    readonly="true"
                    filter="raw"
                />
                <field
                    name="import_json"
                    type="textarea"
                    label="PLG_SYSTEM_FGADMINPAGECUSTOM_IMPORT_JSON_LABEL"
                    description="PLG_SYSTEM_FGADMINPAGECUSTOM_IMPORT_JSON_DESC"
                    rows="10"
                    filter="raw"
                />
            </fieldset>
        </fields>
    </config>
</extension>
